# LEON AI lokale Einstellungen
# Diese Datei zu .env kopieren, wenn du eigene Werte setzen willst.
# Bei einer frischen Installation erstellt der Setup-Screen dein echtes Login-Passwort.
# LEON_PASSWORD bleibt als Fallback/Migrationspasswort fuer bestehende Installationen.

LEON_PASSWORD=change-me-before-release
SECRET_KEY=bitte-durch-einen-langen-zufallswert-ersetzen
PORT=5001
HOST=127.0.0.1
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3
AUTH_ENABLED=true
RATE_LIMIT=30
